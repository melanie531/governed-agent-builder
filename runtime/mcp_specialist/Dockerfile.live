# Build only after host generates the hash-locked live dependency closure.
# docker buildx build --platform linux/arm64 -f runtime/mcp_specialist/Dockerfile.live .
FROM public.ecr.aws/docker/library/python:3.13-slim
WORKDIR /app
COPY runtime/mcp_specialist/requirements-live.lock ./requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY foundations ./foundations
COPY foundation_harness ./foundation_harness
COPY backend ./backend
COPY runtime ./runtime
ARG IMAGE_BUILD=unknown
ENV IMAGE_BUILD=${IMAGE_BUILD} PYTHONUNBUFFERED=1
USER 10001
EXPOSE 8000
CMD ["python", "-m", "runtime.mcp_specialist.alpr_live"]
